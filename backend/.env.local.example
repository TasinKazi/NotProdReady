# backend/.env.local.example — copy to backend/.env.local and fill in values.
#
# This example file IS committed to Git (no real secrets).
# backend/.env.local itself is git-ignored.
#
# ── Bob API key ──────────────────────────────────────────────────────────────
BOB_API_KEY=your-bob-api-key-here

# ── Bob integration settings ─────────────────────────────────────────────────
NOTPRODREADY_BOB_EXECUTABLE=C:\Users\<username>\AppData\Roaming\npm\bob.cmd
NOTPRODREADY_BOB_MODE=shell

NOTPRODREADY_BOB_MAX_COST=2.0
NOTPRODREADY_BOB_MAX_TURNS=15
NOTPRODREADY_BOB_TIMEOUT=300

NOTPRODREADY_BOB_FINALIZE_MAX_COST=0.25
NOTPRODREADY_BOB_FINALIZE_MAX_TURNS=1

NOTPRODREADY_BOB_REMEDIATE_MAX_COST=1.0
NOTPRODREADY_BOB_REMEDIATE_MAX_TURNS=20
